// RUN: %run_cache %s %t 71 3
fn table() -> [u32; 4] { [for i in (1 + 1)..(2 + 4) { i * 7 }] }
fn flags() -> [bool; 3] { [true, false, true] }
fn small() -> [i8; 3] { [for i in 0..3 { -((i + 1) as i8) }] }
fn last(a: [u32; 2]) -> u32 { a[1] }
let a = table();
let b = table();
let flag = flags()[2];
let negative = small()[1] as u32;
let fresh = last([1, 12]) + last([1, 12]);
let result = a[external_input()] + b[0] + fresh + negative;
