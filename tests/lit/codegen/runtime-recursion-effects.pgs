// RUN: %pagosc --max-recursion-depth=1 --max-specializations=1 --max-residual-specializations=1 explain-stage %s | %FileCheck %s
// RUN: %run_residual %s 3 4 5 6 0
// RUN: %run_optimized %s 3 4 5 6 0
fn count() -> u32 {
    if external_input() == 0 { 0 } else { 1 + count() }
}
let result = count();
// CHECK: specializations=1, cache-hits=0, max-depth=1
// CHECK-SAME: residual-specializations=1, residual-cache-hits=1
