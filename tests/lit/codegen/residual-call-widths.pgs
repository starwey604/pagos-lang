// RUN: %run_residual %s 1 255 255 65535 1
// RUN: %run_optimized %s 1 255 255 65535 1
fn signed_byte(x: i8) -> i8 { x / 1i8 }
fn unsigned_byte(x: u8) -> u8 { x / 1u8 }
fn half(x: u16) -> u16 { x + 1u16 }
fn signed_wide(x: i64) -> i64 { x >> 63i64 }
fn wide(x: u64) -> u64 { x << 63u64 }
fn size(x: usize) -> usize { x + 1usize }
fn flag(x: bool) -> bool { !x }
let a = signed_byte(external_input() as i8) as i64;
let b = unsigned_byte(external_input() as u8) as u64;
let c = half(external_input() as u16);
let d = external_input() as u64;
let result = a == -1i64 && b == 255u64 && c == 0u16 &&
             signed_wide(a) == -1i64 && wide(d) == 9223372036854775808u64 &&
             size(d as usize) == 2usize && flag(false);
