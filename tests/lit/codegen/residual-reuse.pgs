// RUN: %pagosc --max-residual-specializations=3 explain-stage %s | %FileCheck %s --check-prefix=STATS
// RUN: %pagosc emit-mir %s | %FileCheck %s --check-prefix=MIR
// RUN: %pagosc emit-llvm %s | %FileCheck %s --check-prefix=IR
// RUN: %run_residual %s 94 3 4 5 6
// RUN: %run_optimized %s 94 3 4 5 6
fn twice(x: u32) -> u32 { x + x }
fn scale(k: u32, x: u32) -> u32 { twice(x) * k }
let a = scale(2, external_input());
let b = scale(2, external_input());
let c = scale(3, external_input());
let d = scale(3, external_input());
let result = a + b + c + d;
// STATS: residual-specializations=3, residual-cache-hits=3
// MIR: call @pagos.scale.0
// MIR: call @pagos.scale.0
// MIR: call @pagos.scale.2
// MIR: call @pagos.scale.2
// MIR: func @pagos.scale.0(u32) -> u32
// MIR: call @pagos.twice.1
// MIR: func @pagos.twice.1(u32) -> u32
// MIR: func @pagos.scale.2(u32) -> u32
// MIR: call @pagos.twice.1
// MIR-NOT: func @
// IR-COUNT-3: define internal i32
// IR-NOT: define internal
