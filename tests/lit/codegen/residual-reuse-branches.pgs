// RUN: %pagosc --max-specializations=1 --max-residual-specializations=1 explain-stage %s | %FileCheck %s
// RUN: %run_residual %s 16 0 3 5
// RUN: %run_residual %s 16 1 3 5
// RUN: %run_optimized %s 16 0 3 5
// RUN: %run_optimized %s 16 1 3 5
fn read() -> u32 { external_input() }
let shared = if external_input() == 0 { read() } else { read() };
let another = read();
let result = shared + shared + another + another;
// CHECK: specializations=1, cache-hits=0
// CHECK-SAME: residual-specializations=1, residual-cache-hits=2
