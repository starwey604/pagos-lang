// RUN: %pagosc emit-hir %s | %FileCheck %s
// RUN: %run_residual %s 1
comptime let complement = ~0;
comptime let mask = 240 & 170;
comptime let either = 240 | 15;
comptime let toggled = 255 ^ 170;
comptime let high = 1 << 31;
comptime let zero = 2 << 31;
comptime let low = 2147483648 >> 31;
comptime let unchanged = 4294967295 >> 0;
comptime let precedence = 1 | 2 ^ 3 & 6;
comptime let additive = 1 << 2 + 1;
comptime let associative = 128 >> 2 >> 1;
comptime let comparison = 1 << 3 < 9;
comptime let unary = ~0 >> 31;
let result = low;
// CHECK: binding complement: u32 [Comptime] = 4294967295
// CHECK: binding mask: u32 [Comptime] = 160
// CHECK: binding either: u32 [Comptime] = 255
// CHECK: binding toggled: u32 [Comptime] = 85
// CHECK: binding high: u32 [Comptime] = 2147483648
// CHECK: binding zero: u32 [Comptime] = 0
// CHECK: binding low: u32 [Comptime] = 1
// CHECK: binding unchanged: u32 [Comptime] = 4294967295
// CHECK: binding precedence: u32 [Comptime] = 1
// CHECK: binding additive: u32 [Comptime] = 8
// CHECK: binding associative: u32 [Comptime] = 16
// CHECK: binding comparison: bool [Comptime] = true
// CHECK: binding unary: u32 [Comptime] = 1
