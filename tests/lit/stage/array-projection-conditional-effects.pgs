// RUN: %run_residual %s 11 1 10
// RUN: %run_residual %s 22 0 20
fn choose(flag: bool) -> u32 {
    if flag {
        comptime let value = [11, external_input()][0];
        value
    } else {
        comptime let value = [22, external_input()][0];
        value
    }
}
let result = choose(external_input() == 1);
