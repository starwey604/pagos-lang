fn probe(n: u32) -> u32 { external_input(); n }
fn size(n: u32) -> u32 { n }
let primed = size(2);
let a = [for i in 0..size(probe(2)) { i }];
let b = [for i in 0..size(probe(2)) { i }];
let result = a[1] + b[1];
