// RUN: not %pagosc check %s 2>&1 | %FileCheck %s
fn explicit(n: u32, flag: bool) -> [u32; 2] {
    if flag { return [for i in 0..n { i }]; } else { [0, 1] }
}
let bad_return = explicit(3, external_input() != 0);
