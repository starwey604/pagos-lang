// RUN: %pagosc explain-stage %s | %FileCheck %s
// RUN: %run_residual %s 40 10 20
fn read(a: [u32; 2]) -> u32 { let alias = a; alias[1] }
runtime let unrelated = external_input();
runtime let selected = external_input();
let table = [unrelated, selected];
let right = read(table);
let result = right + table[1];
// CHECK: right: Runtime (selected -> array element 1 -> table -> read.a -> alias -> array index -> right)
