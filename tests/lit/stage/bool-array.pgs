// RUN: %pagosc emit-hir %s | %FileCheck %s --check-prefix=HIR
// RUN: %pagosc emit-llvm %s | %FileCheck %s --check-prefix=LLVM
// RUN: %run_residual %s 1 0
// RUN: %run_residual %s 0 1
// RUN: %run_residual %s trap 3
static let table: [bool; 3] = [true, false, true];
static let first = table[0];
let result = table[external_input()] && first;
