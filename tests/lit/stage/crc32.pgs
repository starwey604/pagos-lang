// RUN: %pagosc explain-stage %s | %FileCheck %s --check-prefix=STAGE
// RUN: %pagosc emit-llvm %s | %FileCheck %s --check-prefix=LLVM --implicit-check-not=alloca
// RUN: %run_crc32 %s
// RUN: not %pagosc --max-array-elements=255 check %s 2>&1 | %FileCheck %s --check-prefix=ARRAY
// RUN: not %pagosc --max-array-bytes=1023 check %s 2>&1 | %FileCheck %s --check-prefix=ARRAY
// RUN: not %pagosc --max-fuel=100 check %s 2>&1 | %FileCheck %s --check-prefix=FUEL
// RUN: not %pagosc --max-specializations=8 check %s 2>&1 | %FileCheck %s --check-prefix=SPECIALIZATIONS
// RUN: not %pagosc --max-recursion-depth=4 check %s 2>&1 | %FileCheck %s --check-prefix=DEPTH
// RUN: not %pagosc --max-aggregate-members=255 check %s 2>&1 | %FileCheck %s --check-prefix=AGGREGATE
// RUN: not %pagosc --max-aggregate-bytes=1023 check %s 2>&1 | %FileCheck %s --check-prefix=AGGREGATE

// CRC-32/ISO-HDLC: reflected polynomial 0xEDB88320, init/xorout 0xFFFFFFFF.
// Eight recursive bit steps run only during table construction.
fn crc_entry(value: u32, bits: u32) -> u32 {
    if bits == 0 { value } else {
        let next = if (value & 1) != 0 {
            (value >> 1) ^ 3_988_292_384
        } else { value >> 1 };
        crc_entry(next, bits - 1)
    }
}

fn crc_byte(table: [u32; 256], crc: u32, byte: u32) -> u32 {
    (crc >> 8) ^ table[(crc ^ byte) & 255]
}

// Fixed nine-byte message; each u32 contributes its low eight bits.
// Explicit immutable states avoid requiring mutation or Runtime recursion.
fn crc32_9(table: [u32; 256], bytes: [u32; 9]) -> u32 {
    let c0 = crc_byte(table, ~0, bytes[0]);
    let c1 = crc_byte(table, c0, bytes[1]);
    let c2 = crc_byte(table, c1, bytes[2]);
    let c3 = crc_byte(table, c2, bytes[3]);
    let c4 = crc_byte(table, c3, bytes[4]);
    let c5 = crc_byte(table, c4, bytes[5]);
    let c6 = crc_byte(table, c5, bytes[6]);
    let c7 = crc_byte(table, c6, bytes[7]);
    ~crc_byte(table, c7, bytes[8])
}

static let table: [u32; 256] = [for i in 0..256 { crc_entry(i, 8) }];
// ASCII "123456789": 0xCBF43926, decimal 3421780262.
static let known = crc32_9(table, [49, 50, 51, 52, 53, 54, 55, 56, 57]);
let bytes = [external_input(), external_input(), external_input(),
             external_input(), external_input(), external_input(),
             external_input(), external_input(), external_input()];
let result = crc32_9(table, bytes);

// STAGE: table: Static
// STAGE: known: Static
// STAGE: bytes: Runtime
// STAGE: result: Runtime
// STAGE-SAME: external_input -> array element 0 -> bytes -> crc32_9.bytes
// STAGE: aggregate-constructions=3, aggregate-members=274, aggregate-bytes=1096
// LLVM: @pagos.table = private unnamed_addr constant [256 x i32]
// LLVM: define i32 @pagos_main()
// LLVM-COUNT-9: call i32 @pagos_external_input()
// LLVM-COUNT-9: load i32
// LLVM: ret i32
// ARRAY: error[E4008]
// FUEL: error[E4004]
// SPECIALIZATIONS: error[E4006]
// DEPTH: error[E4005]
// AGGREGATE: error[E4010]
