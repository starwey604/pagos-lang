// RUN: %pagosc --target=riscv32-unknown-elf emit-hir %s | %FileCheck %s --check-prefixes=COMMON,RV32
// RUN: %pagosc --target=riscv64-unknown-elf emit-hir %s | %FileCheck %s --check-prefixes=COMMON,RV64
comptime let maximum: usize = ~0usize;
comptime let wrap = maximum + 1usize;
comptime let wide = (4294967295usize + 1usize) as u64;
comptime let negative = -1i8 as usize;
comptime let narrow = maximum as u8;
comptime let signed = maximum as i64;
comptime let same_bits = (1usize as u32 as usize) == 1usize;
fn table(x: usize) -> [usize; 2] { [x, x + 1usize] }
record R { count: usize, flag: bool }
comptime let config = R(count: table(41usize)[1], flag: true);
comptime let field = config.count;
// RV32: maximum: usize [Comptime] = 4294967295
// RV64: maximum: usize [Comptime] = 18446744073709551615
// COMMON: wrap: usize [Comptime] = 0
// RV32: wide: u64 [Comptime] = 0
// RV64: wide: u64 [Comptime] = 4294967296
// RV32: negative: usize [Comptime] = 4294967295
// RV64: negative: usize [Comptime] = 18446744073709551615
// COMMON: narrow: u8 [Comptime] = 255
// RV32: signed: i64 [Comptime] = 4294967295
// RV64: signed: i64 [Comptime] = -1
// COMMON: same_bits: bool [Comptime] = true
// COMMON: field: usize [Comptime] = 42
