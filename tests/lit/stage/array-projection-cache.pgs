// RUN: %pagosc explain-stage %s | %FileCheck %s
// RUN: %run_residual %s 44 10 20
fn twice(value: u32) -> u32 { value * 2 }
comptime let seed = twice(11);
comptime let a = twice([11, external_input()][0]);
comptime let b = twice([11, external_input()][0]);
let result = a + b;
// CHECK: a: Comptime
// CHECK: b: Comptime
// CHECK: result: Comptime
// CHECK: cache-hits=2
