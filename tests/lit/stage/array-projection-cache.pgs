fn twice(value: u32) -> u32 { value * 2 }
static let seed = twice(11);
static let a = twice([11, external_input()][0]);
static let b = twice([11, external_input()][0]);
let result = a + b;
// CHECK: a: Static
// CHECK: b: Static
// CHECK: result: Static
// CHECK: cache-hits=2
