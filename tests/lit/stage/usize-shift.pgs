// RUN: not %pagosc --target=riscv32-unknown-elf check %s 2>&1 | %FileCheck %s --check-prefix=RV32
// RUN: %pagosc --target=riscv64-unknown-elf emit-hir %s | %FileCheck %s --check-prefix=RV64
static let shifted = 1usize << 32usize;
// RV32: error[E4009]: shift count must be less than 32
// RV64: shifted: usize [Static] = 4294967296
