// RUN: %run_residual %s 1 3 2 0
// RUN: %run_residual %s 0 0
// RUN: %run_residual %s 0 2 2 3

fn any_zero(end: u32) -> bool {
    for index in 0..end {
        // A returning arm has no value to unify with the u32 continuation.
        let ignored = if external_input() == 0 { return true; } else { 17 };
    }
    return false;
}
let result = any_zero(external_input());
