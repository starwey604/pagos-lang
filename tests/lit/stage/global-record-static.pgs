// RUN: not %pagosc check %s 2>&1 | %FileCheck %s
record R { value: u32 }
global const config: R = R(value: 1);
static let read = config.value;
static let address = &config.value;
// CHECK: error[E2001]:
// CHECK: global field address config.value
// CHECK: global record read value
// CHECK: error[E2001]:
// CHECK: global field address config.value
