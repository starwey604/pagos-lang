// RUN: not %pagosc check %s 2>&1 | %FileCheck %s
record R { value: u32 }
static const config: R = R(value: 1);
comptime let read = config.value;
comptime let address = &config.value;
// CHECK: error[E2001]:
// CHECK: static storage field address config.value
// CHECK: static storage record read value
// CHECK: error[E2001]:
// CHECK: static storage field address config.value
