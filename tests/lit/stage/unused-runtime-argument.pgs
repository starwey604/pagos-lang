// RUN: %pagosc emit-hir %s | %FileCheck %s
// RUN: %run_residual %s 5 123 456

fn first(first_value: u32, unused: u32) -> u32 {
    return first_value;
}

runtime let input = external_input();
first(5, external_input());
let result = first(5, input);

// CHECK: binding input: u32 [Runtime]
// CHECK: binding result: u32 [Static] = sequence(runtime(external_input()), 5)
