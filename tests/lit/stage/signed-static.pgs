// RUN: %pagosc emit-hir %s | %FileCheck %s
comptime let minimum = -9223372036854775808i64;
comptime let double_negative = --128i8;
comptime let parenthesized = -(128i8);
comptime let wrap = 127i8 + 1i8;
comptime let negated = -wrap;
comptime let division = -7i16 / 3i16;
comptime let remainder = -7i32 % 3i32;
comptime let right = -128i8 >> 7i8;
comptime let sign_extend = -1i8 as u64;
comptime let zero_extend = 255u8 as i16;
comptime let precedence = -1i8 as u16;
comptime let skipped = if false { -128i8 / -1i8 } else { 7i8 };
// CHECK: minimum: i64 [Comptime] = -9223372036854775808
// CHECK: double_negative: i8 [Comptime] = -128
// CHECK: parenthesized: i8 [Comptime] = -128
// CHECK: wrap: i8 [Comptime] = -128
// CHECK: negated: i8 [Comptime] = -128
// CHECK: division: i16 [Comptime] = -2
// CHECK: remainder: i32 [Comptime] = -1
// CHECK: right: i8 [Comptime] = -1
// CHECK: sign_extend: u64 [Comptime] = 18446744073709551615
// CHECK: zero_extend: i16 [Comptime] = 255
// CHECK: precedence: u16 [Comptime] = 65535
// CHECK: skipped: i8 [Comptime] = 7
