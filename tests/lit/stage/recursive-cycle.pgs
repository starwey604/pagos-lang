// RUN: not %pagosc check %s 2>&1 | %FileCheck %s

fn stuck(value: u32) -> u32 {
    stuck(value)
}

let result = stuck(1);

// CHECK: error[E4003]: recursive specialization cycle in `stuck`
// CHECK: the same Static arguments recur
