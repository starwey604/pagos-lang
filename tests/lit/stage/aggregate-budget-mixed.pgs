// RUN: %pagosc --max-aggregate-members=4 --max-aggregate-bytes=13 explain-stage %s | %FileCheck %s --check-prefix=OK
// RUN: not %pagosc --max-aggregate-members=3 check %s 2>&1 | %FileCheck %s --check-prefix=FAIL
// RUN: not %pagosc --max-aggregate-bytes=12 check %s 2>&1 | %FileCheck %s --check-prefix=BYTES
record R { value: u32, flag: bool }
let r = R(value: 1, flag: true);
let a = [2, 3];
// OK: array-elements=2, array-bytes=8, aggregate-constructions=2, aggregate-members=4, aggregate-bytes=13
// FAIL: error[E4010]
// FAIL: request 0 bool members and 2 u32 members; reserved 2/3 members, 5/262144 bytes
// BYTES: error[E4010]
// BYTES: request 0 bool members and 2 u32 members; reserved 2/65536 members, 5/12 bytes
