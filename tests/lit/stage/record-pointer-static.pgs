// RUN: not %pagosc check %s 2>&1 | %FileCheck %s
record R { count: u32 }
comptime let p = 4096usize as *const R;
comptime let address = &(*p).count;
comptime let read = (*p).count;
// CHECK: error[E2001]:
// CHECK: record field address count
// CHECK: error[E2001]:
// CHECK: record field address count
// CHECK: record field read count
