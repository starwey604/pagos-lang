// RUN: %pagosc emit-hir %s | %FileCheck %s
comptime let byte = 255u8 + 1u8;
comptime let half = 0u16 - 1u16;
comptime let wide = 18446744073709551615u64;
comptime let wrap = wide + 1u64;
comptime let narrow = wide as u8;
comptime let widen = narrow as u64;
comptime let precedence = ~0u8 as u64;
comptime let chain = 65535 as u8 as u64;
comptime let skipped = if false { 1u8 << 8u8 } else { 7u8 };
// CHECK: byte: u8 [Comptime] = 0
// CHECK: half: u16 [Comptime] = 65535
// CHECK: wide: u64 [Comptime] = 18446744073709551615
// CHECK: wrap: u64 [Comptime] = 0
// CHECK: narrow: u8 [Comptime] = 255
// CHECK: widen: u64 [Comptime] = 255
// CHECK: precedence: u64 [Comptime] = 255
// CHECK: chain: u64 [Comptime] = 255
// CHECK: skipped: u8 [Comptime] = 7
