// RUN: %pagosc explain-provenance %s | %FileCheck %s --check-prefix=GRAPH
// RUN: %pagosc emit-llvm %s | %FileCheck %s --check-prefix=LLVM
fn set(p: *mut u32) -> u32 { volatile *p = 42; 7 }
runtime let dynamic = 20;
let arithmetic = dynamic + 10;
comptime let result = set(4096usize as *mut u32);
