// RUN: %pagosc --max-recursion-depth=1 --max-residual-specializations=1 emit-mir %s | %FileCheck %s

fn recurse(value: u32) -> u32 {
    recurse(value)
}

runtime let input = external_input();
let result = recurse(input);

// No termination guarantee: compile only, never execute this infinite loop.
// CHECK: func @pagos_main() -> u32
// CHECK: call @pagos.recurse.0
// CHECK: func @pagos.recurse.0(u32) -> u32
// CHECK: call @pagos.recurse.0
// CHECK-NOT: func @
