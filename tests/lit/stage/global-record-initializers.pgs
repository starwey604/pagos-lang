// RUN: not %pagosc check %s 2>&1 | %FileCheck %s
record R { value: u32 }
static mut source: R = R(value: 0);
static const read: R = R(value: source.value);
record P { address: usize }
static const address: P = P(address: &source.value as usize);
static const input: R = R(value: external_input());
fn hidden() -> R { *&source.value = 7; R(value: 0) }
static const effect: R = hidden();
static mut bad_bss: R section(".bss.bad") = R(value: 1);
// CHECK: error[E2010]: static storage initializer must be pure Comptime
// CHECK: static storage field address source.value
// CHECK: static storage record read value
// CHECK: static storage initializer read
// CHECK: error[E2010]: static storage initializer must be pure Comptime
// CHECK: static storage initializer address
// CHECK: error[E2010]: static storage initializer must be pure Comptime
// CHECK: static storage initializer input
// CHECK: error[E2010]: static storage initializer must be pure Comptime
// CHECK: static storage initializer effect
// CHECK: error[E2011]: BSS storage requires a zero initializer
