// RUN: %run_residual %s 103 1 20
// RUN: %run_residual %s 144 0 20 30

fn combine(a: u32, b: u32, c: u32) -> u32 { a + b + c }
fn caller(flag: bool) -> u32 {
    let value = combine(external_input(),
        if flag { return 3; } else { 4 }, external_input());
    return value - 10;
}
let result = caller(external_input() == 1) + 100;
