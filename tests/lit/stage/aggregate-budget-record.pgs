// RUN: %pagosc --max-aggregate-members=2 --max-aggregate-bytes=5 explain-stage %s | %FileCheck %s --check-prefix=OK
// RUN: not %pagosc --max-aggregate-members=1 check %s 2>&1 | %FileCheck %s --check-prefix=MEMBERS
// RUN: not %pagosc --max-aggregate-bytes=4 check %s 2>&1 | %FileCheck %s --check-prefix=BYTES
// RUN: %pagosc --max-array-elements=0 --max-array-bytes=0 check %s
record R { value: u32, flag: bool }
let result = R(flag: true, value: 7).value;
// OK: array-elements=0, array-bytes=0, aggregate-constructions=1, aggregate-members=2, aggregate-bytes=5
// MEMBERS: error[E4010]: aggregate construction budget exceeded
// MEMBERS: request 1 bool members and 1 u32 members; reserved 0/1 members, 0/262144 bytes
// BYTES: error[E4010]: aggregate construction budget exceeded
// BYTES: request 1 bool members and 1 u32 members; reserved 0/65536 members, 0/4 bytes
