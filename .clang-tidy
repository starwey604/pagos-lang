Checks: >
  -*,
  bugprone-*,
  -bugprone-exception-escape,
  -bugprone-unchecked-optional-access,
  clang-analyzer-*,
  -clang-analyzer-security.ArrayBound,
  performance-*,
  -performance-enum-size
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include|lib|tools|tests)/'
CheckOptions:
  bugprone-easily-swappable-parameters.MinimumLength: '4'
  # Destructors use explicit (void) for best-effort cleanup errors. Bare
  # discarded error/expected results remain diagnostics.
  bugprone-unused-return-value.AllowCastToVoid: 'true'
